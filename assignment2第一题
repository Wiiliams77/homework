using System;

class Program
{
    static void Main()
    {
        Console.Write("请输入一个整数: ");
        if (int.TryParse(Console.ReadLine(), out int number) && number > 1)
        {
            Console.Write("素数因子: ");
            FindPrimeFactors(number);
        }
        else
        {
            Console.WriteLine("请输入一个大于 1 的整数。");
        }
    }

    static void FindPrimeFactors(int n)
    {
        for (int i = 2; i * i <= n; i++)
        {
            while (n % i == 0)
            {
                Console.Write(i + " ");
                n /= i;
            }
        }
        if (n > 1) 
        {
            Console.Write(n);
        }
        Console.WriteLine();
    }
}
