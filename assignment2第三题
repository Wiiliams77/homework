using System;

class Program
{
    static void Main()
    {
        int n = 100;
        bool[] isPrime = new bool[n + 1];

        
        for (int i = 2; i <= n; i++)
        {
            isPrime[i] = true;
        }

        
        for (int i = 2; i * i <= n; i++)
        {
            if (isPrime[i])
            {
                for (int j = i * i; j <= n; j += i)
                {
                    isPrime[j] = false;
                }
            }
        }

        
        Console.WriteLine("2~100 以内的素数有:");
        for (int i = 2; i <= n; i++)
        {
            if (isPrime[i])
            {
                Console.Write(i + " ");
            }
        }
    }
}
